# Test keys only. Never commit real values. Set these on the Vercel project
# that deploys the stripe-api folder (Root Directory: stripe-api).

# Restricted test secret (rk_test_...) or standard test secret (sk_test_...).
# Live keys are rejected by the API.
STRIPE_SECRET_KEY=

# Signing secret from the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Signing secret of the Connect endpoint (connected accounts, account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Firebase Admin service account JSON, as a single line.
FIREBASE_SERVICE_ACCOUNT=

# Optional. Vercel sends Authorization: Bearer <CRON_SECRET> to the daily payout job (Hobby plan: once a day).
CRON_SECRET=

# Masked phone calls. Leave empty until a number pool is approved.
# The call buttons hide "Ring via telefon" while these are unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One number, or several separated by commas.
TWILIO_PROXY_NUMBER=
TWILIO_PROXY_NUMBERS=
# Set this instead of the number pool when using Twilio Proxy.
TWILIO_PROXY_SERVICE_SID=
# Exact voice webhook URL configured on the Twilio number.
TWILIO_WEBHOOK_URL=

# Invoice seller. Missing values make the invoice a draft, not a finished invoice.
VELIO_COMPANY_NAME=
VELIO_ORG_NR=
VELIO_VAT_NR=
VELIO_ADDRESS=
VELIO_EMAIL=
VELIO_F_SKATT=
VELIO_VAT_REGISTERED=
VELIO_VAT_RATE=25

# Bolagsverket, free "värdefulla datamängder" API. Leave empty until the keys arrive.
# Register at https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/vardefulladatamangder.5294.html
# You get client_id and client_secret by email and SMS. No agreement and no fee.
# The free API looks up one organisation number. It cannot search by company name.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# Optional. Defaults are the production gateway. For the test keys, use the accept2 hosts.
# BOLAGSVERKET_TOKEN_URL=https://portal.api.bolagsverket.se/oauth2/token
# BOLAGSVERKET_API_BASE=https://gw.api.bolagsverket.se/vardefulla-datamangder/v1

# Idura (formerly Criipto) free BankID test tenant. Leave empty until the test application exists.
# Sign up at the Idura dashboard, no credit card. Create a tenant, a .test.idura.broker domain,
# and a confidential Verify application. Enable Swedish BankID in the test environment.
# Real BankID cannot be used against the test tenant.
IDURA_DOMAIN=
IDURA_CLIENT_ID=
IDURA_CLIENT_SECRET=
# Optional extra salt for the personnummer hash. The client secret is used if this is empty.
# The number itself is never stored.
IDURA_PERSONNUMMER_SALT=

# Optional. Buyer email with the PDF is skipped when these are empty.
RESEND_API_KEY=
RESEND_FROM=

# Frontend (GitHub Pages / Next build), not read by this API:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_VELIO_API_BASE=https://<your-vercel-domain>
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
