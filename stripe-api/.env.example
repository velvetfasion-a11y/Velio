# Test keys only. Never commit real values. Set these on the Vercel project
# that deploys the stripe-api folder (Root Directory: stripe-api).

# Restricted test secret (rk_test_...) or standard test secret (sk_test_...).
# Live keys are rejected by the API.
STRIPE_SECRET_KEY=

# Signing secret from the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Signing secret of the Connect endpoint (connected accounts, account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Firebase Admin service account JSON, as a single line.
FIREBASE_SERVICE_ACCOUNT=

# Optional. Vercel sends Authorization: Bearer <CRON_SECRET> to the daily payout job (Hobby plan: once a day).
CRON_SECRET=

# Masked phone calls. Leave empty until a number pool is approved.
# The call buttons hide "Ring via telefon" while these are unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One number, or several separated by commas.
TWILIO_PROXY_NUMBER=
TWILIO_PROXY_NUMBERS=
# Set this instead of the number pool when using Twilio Proxy.
TWILIO_PROXY_SERVICE_SID=
# Exact voice webhook URL configured on the Twilio number.
TWILIO_WEBHOOK_URL=

# Frontend (GitHub Pages / Next build), not read by this API:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_VELIO_API_BASE=https://<your-vercel-domain>
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
