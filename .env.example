# Copy to .env. Never commit the real file. .env is gitignored.

# Idura Verify, TEST environment (Swedish BankID and Freja eID).
# The client secret must only live here, on the server. Do not put it in NEXT_PUBLIC_*.
IDURA_ISSUER=https://velio.test.idura.broker
IDURA_CLIENT_ID=urn:my:application:identifier:289054
IDURA_CLIENT_SECRET=

# Origin used to build the OAuth redirect URI. npm run dev listens on port 8080, not 3000.
# Register this exact redirect URI in the Idura dashboard:
#   http://localhost:8080/api/auth/idura/callback
# Open the app at the same origin (http://localhost:8080), otherwise the login cookie will not match.
APP_BASE_URL=http://localhost:8080

# Stable secret for session cookies and for encrypting stored personnummer.
# Required wherever the database outlives the process. Rotating it makes existing
# personnummer hashes unreadable, so the same person can get a second eID account.
AUTH_SECRET=

# Optional other login methods. BankID/Freja accounts cannot use these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Direct BankID relying-party API (separate from Idura). Leave empty to use only Idura.
BANKID_API_URL=
BANKID_API_KEY=

# Postgres in production. Unset locally to use in-memory PGlite.
DATABASE_URL=
